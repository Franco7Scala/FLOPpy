import math
import csv
import numpy
import matplotlib.pyplot
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim
from torchvision import datasets, transforms
from torch.utils.data import DataLoader, random_split
from sklearn.metrics import precision_score, recall_score, f1_score, accuracy_score

# Parametri
batch_size = 128
epochs = 5
random_state = 42
learning_rate = 1e-3
momentum = 0.9
num_workers = 2
pin_memory = False
device = "cuda" if torch.cuda.is_available() else "cpu"

# DataSet
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.2860,), (0.3530,))
])

root = "./data"
train_full = datasets.FashionMNIST(root, train=True, download=True, transform=transform)
test_set = datasets.FashionMNIST(root, train=False, download=True, transform=transform)

val_size = int(0.33 * len(train_full))
train_size = len(train_full) - val_size
g = torch.Generator().manual_seed(random_state)
train_set, val_set = random_split(train_full, [train_size, val_size], generator=g)

train_loader = DataLoader(train_set, batch_size=batch_size, shuffle=True, num_workers=num_workers, pin_memory=pin_memory)
val_loader = DataLoader(val_set, batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=pin_memory)
test_loader = DataLoader(test_set, batch_size=batch_size, shuffle=False, num_workers=num_workers, pin_memory=pin_memory)

# Modello
class Cnn(nn.Module):
  def __init__(self, device):
    super(Cnn, self).__init__()
    self.device = device
    self.conv1 = nn.Conv2d(1, 10, kernel_size=5)
    self.conv2 = nn.Conv2d(10, 20, kernel_size=5)
    self.conv2_drop = nn.Dropout2d()
    self.fc1 = nn.Linear(320, 50)
    self.fc2 = nn.Linear(50, 10)
    self.to(self.device)

  def forward(self, x):
    x = F.relu(F.max_pool2d(self.conv1(x), 2))
    x = F.relu(F.max_pool2d(self.conv2_drop(self.conv2(x)), 2))
    x = x.view(-1, 320)
    x = F.relu(self.fc1(x))
    x = F.dropout(x, training=self.training)
    x = self.fc2(x)
    return F.log_softmax(x, dim = 1)

  def evaluate(self, test_loader):
    self.eval()
    test_loss = 0
    correct = 0
    all_preds = []
    all_targets = []
    with torch.no_grad():
        for data, target in test_loader:
            output = self(data.to(self.device))
            test_loss += F.nll_loss(output.to(self.device), target.to(self.device), reduction='sum').item()
            pred = output.to("cpu").data.max(1, keepdim=True)[1]
            correct += pred.eq(target.to("cpu").data.view_as(pred)).sum()
            all_preds.extend([i.item() for i in pred])
            all_targets.extend(target.cpu().numpy())

    test_loss /= len(test_loader.dataset)
    accuracy = (correct / len(test_loader.dataset) * 100).item()
    precision = precision_score(all_targets, all_preds, average='weighted', zero_division=1)
    recall = recall_score(all_targets, all_preds, average='weighted', zero_division=1)
    f1 = f1_score(all_targets, all_preds, average='weighted', zero_division=1)
    return test_loss, accuracy, precision, recall, f1

  # FLOPs
  def conv2d_out_shape(self, H_in, W_in, kernel_size, stride=1, pad=0, dilation=1):
    H_out = math.floor((H_in + 2 * pad - dilation * (kernel_size - 1) - 1) / stride + 1)
    W_out = math.floor((W_in + 2 * pad - dilation * (kernel_size - 1) - 1) / stride + 1)
    return H_out, W_out

  def flops_conv2d(self, B, H_out, W_out, C_in, C_out, kernel_height, kernel_width, groups=1):
    macs = H_out * W_out * C_out * (kernel_height * kernel_width * C_in // groups)
    flops = 2 * macs * B
    return flops

  def fc_flops(self, B, input_size, output_size):
    flops = 2 * B * input_size * output_size
    return flops

  def cnn_forward_floops_batch(self, batch_size, h_in=28, w_in=28):
    B = batch_size
    # conv1
    C_in = 1
    C_out = 10
    k = 5
    kernel_height, kernel_width = k, k
    H_out, W_out = self.conv2d_out_shape(h_in, w_in, kernel_size=k, stride=1, pad=0, dilation=1)
    flops_conv1 = self.flops_conv2d(B, H_out, W_out, C_in, C_out, kernel_height, kernel_width, groups=1)
    h_in = H_out // 2
    w_in = W_out // 2

    # conv2
    C_in = 10
    C_out = 20
    k = 5
    kernel_height, kernel_width = k, k
    H_out, W_out = self.conv2d_out_shape(h_in, w_in, kernel_size=k, stride=1, pad=0, dilation=1)
    flops_conv2 = self.flops_conv2d(B, H_out, W_out, C_in, C_out, kernel_height, kernel_width, groups=1)
    h_in = H_out // 2
    w_in = W_out // 2

    #fc1
    flops_fc1 = self.fc_flops(B, 320, 50)

    #fc2
    flops_fc2 = self.fc_flops(B, 50, 10)

    flops_forward = flops_conv1 + flops_conv2 + flops_fc1 + flops_fc2
    return flops_forward

  def cnn_training_floops_batch(self, batch_size):
    training = 3 * self.cnn_forward_floops_batch(batch_size)
    return training

torch.manual_seed(random_state)
model = Cnn(device)
optimizer = torch.optim.SGD(model.parameters(), lr=learning_rate, momentum=momentum)

# Training & monitoraggio
batch_log = []
epoch_flops_list = []
cum_epoch_flops_list = []
tot_flops = 0

for epoch in range(1, epochs+1):
  model.train()
  current_flops_epoch = 0
  steps = len(train_loader)

  for step, (data, target) in enumerate(train_loader, start=1):
    data = data.to(device)
    target = target.to(device)

    optimizer.zero_grad(set_to_none=True)
    output = model(data)
    loss = F.nll_loss(output, target)
    loss.backward()
    optimizer.step()

    # FLOPs per batch
    B = data.shape[0]
    flops_batch = model.cnn_training_floops_batch(B)
    current_flops_epoch += flops_batch
    tot_flops += flops_batch

    batch_log.append((epoch, step, flops_batch, current_flops_epoch, tot_flops))

  # Valutazione
  val_loss, val_accuracy, val_precision, val_recall, val_f1 = model.evaluate(val_loader)
  test_loss, test_accuracy, test_precision, test_recall, test_f1 = model.evaluate(test_loader)
  epoch_flops_list.append(current_flops_epoch)
  cum_epoch_flops_list.append(tot_flops)

# Salvataggio log
with open("cnn_flops_batch_log.csv", "w", newline="") as csvfile:
  writer = csv.writer(csvfile)
  writer.writerow(["epoch", "step", "flops_batch", "flops_epoch", "tot_flops"])
  writer.writerows(batch_log)

with open("cnn_flops_epoch_log.csv", "w", newline="") as csvfile:
  writer = csv.writer(csvfile)
  writer.writerow(["epoch", "flops_epoch", "tot_flops"])
  writer.writerows(zip(range(1, epochs+1), epoch_flops_list, cum_epoch_flops_list))
