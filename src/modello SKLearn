import math
import csv
import numpy
from sklearn.datasets import load_breast_cancer
from sklearn.linear_model import SGDClassifier
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score

# parametri
batch_size = 256
epochs = 5
random_state = 42
loss = "log_loss"
alpha = 1e-4
learning_rate = 0.01
shuffle_per_epoch = True

# DataSet
X, y = load_breast_cancer(return_X_y=True)
X_temp, X_test, y_temp, y_test = train_test_split(X, y, test_size=0.33, random_state=random_state, stratify=y)
X_train, X_val, y_train, y_val = train_test_split(X_temp, y_temp, test_size=0.3882, random_state=random_state, stratify=y_temp)

scaler = StandardScaler()
X_train = scaler.fit_transform(X_train)
X_val = scaler.transform(X_val)
X_test = scaler.transform(X_test)

m, f = X_train.shape

# FLOPs
def flops_log_batch (B: int, f: int, n_classes: int = 1) -> int:
  return 4 * B * f * n_classes

# Modello
clf = SGDClassifier(
    loss=loss,
    alpha=alpha,
    learning_rate="constant",
    eta0=learning_rate,
    random_state=random_state,
    warm_start=True,
    max_iter = 1, tol = None
)

classes = numpy.unique(y_train)
init_B = min(batch_size, X_train.shape[0])
clf.partial_fit(X_train[:init_B], y_train[:init_B], classes=classes)

# Training & monitoraggio
steps_per_epoch = math.ceil(m / batch_size)
tot_flops = 0
log_rows = []

for epoch in range(1, epochs+1):
  if shuffle_per_epoch:
    perm = numpy.random.permutation(m)
    X_train = X_train[perm]
    y_train = y_train[perm]

  flops_epoch = 0

  for step in range(steps_per_epoch):
    start_idx = step * batch_size
    end_idx = min((step + 1) * batch_size, m)
    B = end_idx - start_idx
    X_batch = X_train[start_idx:end_idx]
    y_batch = y_train[start_idx:end_idx]

    clf.partial_fit(X_batch, y_batch)

    # FLOPs del batch
    flops_batch = flops_log_batch(B, f, n_classes=1)
    flops_epoch += flops_batch
    tot_flops += flops_batch

    log_rows.append((epoch, step+1, flops_batch, flops_epoch, tot_flops))

  # Valutazione
  val_acc = accuracy_score(y_val, clf.predict(X_val))
  test_acc = accuracy_score(y_test, clf.predict(X_test))

# Salvataggio log
with open("clf_flops_log.csv", "w", newline="") as csvfile:
  writer = csv.writer(csvfile)
  writer.writerow(["epoch", "step", "flops_batch", "flops_epoch", "tot_flops"])
  writer.writerows(log_rows)

with open("clf_flops_epoch_log.csv", "w", newline="") as csvfile:
  writer = csv.writer(csvfile)
  writer.writerow(["epoch", "flops_epoch", "tot_flops"])
  writer.writerows(zip([row[0] for row in log_rows], [row[3] for row in log_rows], [row[4] for row in log_rows]))
